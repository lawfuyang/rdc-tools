{
  "typeCheckingMode": "standard",
  "pythonVersion": "3.8",
  "include": ["src/py", "tests"],
  "exclude": ["renderdoc-src", "typings", "**/__pycache__", "build", "bin"],
  "stubPath": "typings",
  "extraPaths": ["src/py", "."],
  "reportUnusedImport": "warning",
  "reportUnusedVariable": "warning"
}
